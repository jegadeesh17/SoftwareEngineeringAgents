{
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(python -m engine.build_agents *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_generated.py\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/regen_agents.py\"", "timeout": 60 }
        ]
      }
    ]
  }
}
